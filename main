// ==================== TYPES ====================
interface Category {
  id: string
  name: string
  description: string
  icon: string
  count: number
}

interface Testimonial {
  name: string
  role: string
  content: string
  rating: number
}

interface SavedLetter {
  id: string
  title: string
  category: string
  preview: string
  date: string
  wordCount: number
  rating?: number
}

interface UserStats {
  totalLetters: number
  savedLetters: number
  avgRating: number
  lastGenerated: string
}

