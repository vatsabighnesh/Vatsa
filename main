          font-family: 'Poppins', sans-serif;
          font-weight: 600;
        }
        
        .btn-primary {
          background-color: #2563eb;
          color: white;
          font-weight: 500;
          padding: 0.625rem 1.5rem;
          border-radius: 0.5rem;
          transition: all 0.2s;
          border: none;
          cursor: pointer;
        }
        
